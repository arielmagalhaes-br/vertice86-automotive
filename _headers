# Cabeçalhos de segurança (Cloudflare Pages). Este arquivo precisa ficar na raiz, junto do index.html.
/*
  X-Content-Type-Options: nosniff
  X-Frame-Options: DENY
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: camera=(), microphone=(), geolocation=(), payment=(), usb=(), interest-cohort=()
  Cross-Origin-Opener-Policy: same-origin
  Strict-Transport-Security: max-age=31536000
  Content-Security-Policy: default-src 'self'; script-src 'self' 'sha256-1s0g9pxwEUAtLhuS7aLiMPBe4ljcVOxlIiZOfpB87DQ='; style-src 'self'; img-src 'self' data: blob:; font-src 'self'; media-src 'self' blob:; connect-src 'self' blob:; frame-src https://maps.google.com https://www.google.com; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'

/*.mp4
  Cache-Control: public, max-age=31536000, immutable
/*.jpg
  Cache-Control: public, max-age=86400
/*.svg
  Cache-Control: public, max-age=86400
/fontes/*
  Cache-Control: public, max-age=31536000, immutable
